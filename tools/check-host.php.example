<?php
// Temporary, optional host check. Set a NEW random token hash and an expiry <=15 minutes.
// Upload under a temporary name, open with HTTPS, then delete. Never use phpinfo().
$expected_sha256 = '';
$expires_at = 0;
header('Cache-Control: no-store');header('X-Content-Type-Options: nosniff');header('Referrer-Policy: no-referrer');
header("Content-Security-Policy: default-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'");
if(!preg_match('/^[a-f0-9]{64}$/D',$expected_sha256)||$expires_at<time()||$expires_at>time()+900||empty($_SERVER['HTTPS'])||strtolower($_SERVER['HTTPS'])==='off'){http_response_code(404);exit;}
if(($_SERVER['REQUEST_METHOD']??'GET')!=='POST'){echo '<!doctype html><html lang="fa" dir="rtl"><meta charset="utf-8"><title>بررسی محیط مرشد</title><form method="post"><label>کلید موقت بررسی <input type="password" name="token" required autocomplete="off"></label><button>بررسی</button></form></html>';exit;}
$token=$_POST['token']??'';
if(!is_string($token)||strlen($token)>128||!hash_equals($expected_sha256,hash('sha256',$token))){http_response_code(403);exit;}
$extensions=[];foreach(['pdo_mysql','curl','openssl','fileinfo','mbstring'] as $extension){$extensions[$extension]=extension_loaded($extension);}
header('Content-Type: application/json; charset=utf-8');
echo json_encode(['php_version'=>PHP_VERSION,'php_82_or_later'=>PHP_VERSION_ID>=80200,'extensions'=>$extensions,'https'=>true,'upload_max_filesize'=>ini_get('upload_max_filesize'),'post_max_size'=>ini_get('post_max_size'),'memory_limit'=>ini_get('memory_limit'),'public_directory_writable'=>is_writable(__DIR__)],JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE);
