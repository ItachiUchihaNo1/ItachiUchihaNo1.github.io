generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  phone           String               @unique
  name            String?
  city            String?
  roleInOrg       String?
  roles           String[]             @default(["HAYAT_JOO"])
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organizations   OrganizationMember[]
  tickets         Ticket[]
  expertProfile   ExpertProfile?
  consultationsAsUser   ConsultationSession[] @relation("ConsultationUser")
  consultationsAsExpert ConsultationSession[] @relation("ConsultationExpert")
  reviews         Review[]
  notifications   Notification[]
  auditLogs       AuditLog[]           @relation("AuditActor")
  experiencesCreated Experience[]      @relation("ExperienceCreatedBy")
  experiencesEdited  Experience[]      @relation("ExperienceEditedBy")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  type        String?
  city        String?
  description String?
  createdAt   DateTime             @default(now())
  members     OrganizationMember[]
  tickets     Ticket[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  title          String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model OtpCode {
  id          String   @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([phone, createdAt])
}

model ExpertProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  bio              String
  headline         String
  domains          String[]
  tags             String[]
  yearsExperience  Int                @default(0)
  capacityWeek     Int                @default(2)
  capacityMonth    Int                @default(8)
  sessionDurations Int[]              @default([30, 45])
  experienceCount  Int                @default(0)
  isVerified       Boolean            @default(false)
  publicLinks      Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots            AvailabilitySlot[]
  consultations    ConsultationSession[]
}

model AvailabilitySlot {
  id              String        @id @default(cuid())
  expertProfileId String
  startsAt        DateTime
  duration        Int
  isBooked        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  consultation    ConsultationSession?

  @@index([expertProfileId, startsAt])
}

model Ticket {
  id                String            @id @default(cuid())
  userId            String
  organizationId    String?
  domain            String
  title             String
  description       String
  currentStatusText String?
  experienceNeeded  String?
  city              String?
  status            String            @default("SUBMITTED")
  moderatorNote     String?
  attachments       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  matchingRequest   MatchingRequest?
  consultations     ConsultationSession[]

  @@index([status, createdAt])
  @@index([domain, city])
}

model MatchingRequest {
  id               String   @id @default(cuid())
  ticketId         String   @unique
  suggestedExperts Json
  autoMatchFlag    Boolean  @default(true)
  createdAt        DateTime @default(now())
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model ConsultationSession {
  id               String            @id @default(cuid())
  ticketId         String
  userId           String
  expertId         String
  expertProfileId  String
  availableSlotId  String?           @unique
  startTime        DateTime
  duration         Int
  channel          String            @default("video")
  status           String            @default("SCHEDULED")
  meetingRoom      String            @unique
  recordingConsent String            @default("NONE")
  userNote         String?
  expertNote       String?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user             User              @relation("ConsultationUser", fields: [userId], references: [id], onDelete: Cascade)
  expert           User              @relation("ConsultationExpert", fields: [expertId], references: [id], onDelete: Cascade)
  expertProfile    ExpertProfile     @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  availableSlot    AvailabilitySlot? @relation(fields: [availableSlotId], references: [id], onDelete: SetNull)
  review           Review?
  experience       Experience?

  @@index([userId, startTime])
  @@index([expertId, startTime])
}

model Experience {
  id              String               @id @default(cuid())
  title           String
  domain          String
  subdomain       String?
  city            String?
  orgType         String?
  problem         String
  solutions       String[]
  keyPoints       String[]
  pitfalls        String[]
  warnings        String[]
  prerequisites   String[]
  tags            String[]
  accessLevel     String               @default("PUBLIC")
  status          String               @default("PUBLISHED")
  sourceSessionId String?              @unique
  createdById     String
  editedById      String?
  publishedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  sourceSession   ConsultationSession? @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("ExperienceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  editedBy        User?                @relation("ExperienceEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([domain, publishedAt])
}

model Review {
  id        String              @id @default(cuid())
  sessionId String              @unique
  userId    String
  rating    Int
  comment   String?
  flags     String[]
  createdAt DateTime            @default(now())
  session   ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  timestamp  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, timestamp])
}
